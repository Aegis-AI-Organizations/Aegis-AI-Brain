# Aegis AI - Brain Configuration Template
# Copy this file to .env and fill in the values.
# .env is ignored by version control.

# --- gRPC Server ---
# GRPC_PORT=50051

# --- Temporal ---
# TEMPORAL_HOST=localhost:7233
# BRAIN_TASK_QUEUE=BRAIN_TASK_QUEUE

# --- Database ---
# POSTGRES_DB=aegis_db
# POSTGRES_USER=aegis_admin
# POSTGRES_PASSWORD=your_password_here
# DB_HOST=localhost:5432

# --- Security ---
# JWT_SECRET MUST be set in non-dev environments.
# For local dev, you can set it here:
JWT_SECRET=super-secret-local-dev-key

# --- Debug ---
# SQLALCHEMY_ECHO=false
# ENV=dev
# DEBUG=true
